{
  "name": "grindoors-discord-bot",
  "version": "1.0.0",
  "description": "Phase 1: Discord Security, Community Operations, Games & Automation Bot for the GRINDOORS NFT community.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --transpile-only src/index.ts",
    "dev:watch": "nodemon --exec ts-node --transpile-only src/index.ts",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "deploy:commands": "ts-node src/deploy-commands.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.25.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "luxon": "^3.5.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "svg-captcha": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.4.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
